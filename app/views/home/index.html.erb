<div class="min-h-screen flex items-center justify-center bg-gray-100">
  <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-md">
    <div class="text-center mb-8">
      <img src="https://img5.pic.in.th/file/secure-sv1/-edited-removebg-preview.png" 
      alt="โลโก้กาแฟ edited removebg preview" border="0" height="100" width="100" class="mx-auto">
      <h1 class="text-3xl font-bold text-gray-800">Welcome</h1>
      <p class="text-gray-500 mt-2">Please sign in to continue</p>
    </div>

    <%= form_with scope: :user, url: user_session_path, local: true, class: "space-y-6" do |f| %>
      <div>
        <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.email_field :email, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition", placeholder: "Email address" %>
      </div>

      <div>
        <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.password_field :password, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition", placeholder: "Password" %>
      </div>

      <div>
        <%= f.submit "Sign In", class: "w-full bg-red-500 hover:bg-red-600 text-white font-bold py-3 rounded-lg shadow transition cursor-pointer" %>
      </div>
    <% end %>
    
    <div class="mt-6 text-center text-sm text-gray-600">
      Don't have an account? 
      <%= link_to "Sign up", new_user_registration_path, class: "text-red-500 hover:underline font-semibold" %>
    </div>
  </div>
</div>