<div class="min-h-screen bg-white">
  <!-- Navbar -->
  <nav class="bg-white border-b border-gray-100 py-4 px-8 sticky top-0 z-50" data-controller="navbar">
    <div class="flex justify-between items-center">
      <!-- Left Side: Logo and Menu -->
      <div class="flex items-center space-x-8">
        <!-- Logo -->
        <div class="flex items-center">
          <img src="https://img5.pic.in.th/file/secure-sv1/-edited-removebg-preview.png" alt="Logo" class="h-12 w-12 mr-3">
          
        </div>

        <!-- Desktop Menu Links -->
        <div class="hidden md:flex space-x-8 text-gray-600 font-medium">
          <a href="#" class="hover:text-red-500 transition">Breakfast</a>
          <a href="#" class="hover:text-red-500 transition">Lunch</a>
          <a href="#" class="hover:text-red-500 transition">Dinner</a>
          <a href="#" class="hover:text-red-500 transition">Dessert</a>
          <a href="#" class="hover:text-red-500 transition">Drinks</a>
          <a href="#" class="hover:text-red-500 transition">Snacks & Appetizers</a>
          
        </div><a href="#" class="text-red-500 underline decoration-4 underline-offset-8">All recipes </a>
      </div>

      <!-- Right Side: Buttons -->
      <div class="flex items-center space-x-4">
        <!-- For Admin Button -->
        <div>
          <%= link_to "For Admin", admin_login_path, class: "bg-red-500 hover:bg-red-600 text-white font-bold py-2 px-6 rounded shadow transition text-sm whitespace-nowrap" %>
        </div>

        <!-- Hamburger Button -->
        <button data-action="click->navbar#toggle" class="md:hidden text-gray-500 hover:text-red-500 focus:outline-none p-2">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div data-navbar-target="mobileMenu" class="hidden md:hidden mt-4 pb-4 border-t border-gray-100 pt-4">
      <div class="flex flex-col space-y-4 text-gray-600 font-medium text-center">
        <a href="#" class="hover:text-red-500 transition block py-2">Breakfast</a>
        <a href="#" class="hover:text-red-500 transition block py-2">Lunch</a>
        <a href="#" class="hover:text-red-500 transition block py-2">Dinner</a>
        <a href="#" class="hover:text-red-500 transition block py-2">Dessert</a>
        <a href="#" class="hover:text-red-500 transition block py-2">Drinks</a>
        <a href="#" class="hover:text-red-500 transition block py-2">Snacks & Appetizers</a>
        <a href="#" class="text-red-500 block py-2">All recipes</a>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <!-- Breadcrumb -->
    <div class="mb-8 text-gray-600 font-medium">
      <span>Home</span>
      <span class="mx-2">/</span>
      <span class="text-red-500">All recipes</span>
    </div>

    <!-- Recipe Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <% @recipes.each do |recipe| %>
        <div class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition border border-gray-100 flex flex-col">
          <!-- Image -->
          <div class="h-48 overflow-hidden bg-gray-100 relative">
            <% if recipe.image.attached? %>
              <%= image_tag recipe.image, class: "w-full h-full object-cover transition transform hover:scale-105 duration-300" %>
            <% else %>
              <div class="flex items-center justify-center h-full text-gray-300">
                <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
              </div>
            <% end %>
          </div>

          <!-- Content -->
          <div class="p-6 flex-1 flex flex-col">
            <div class="mb-2">
              <span class="text-xs font-bold uppercase tracking-wider text-orange-500">
                <%= recipe.category&.name || "General" %>
              </span>
            </div>
            
            <h3 class="text-xl font-bold text-gray-900 mb-2 leading-tight">
              <%= link_to recipe.name, recipe_path(recipe), class: "hover:text-red-500 transition" %>
            </h3>
            
            <p class="text-gray-500 text-sm mb-4 line-clamp-3 flex-1">
              <%= recipe.description %>
            </p>
            
            <div class="flex items-center justify-between mt-auto pt-4 border-t border-gray-50">
              <span class="text-xs text-gray-400 font-medium">
                <%= recipe.created_at.strftime("%d %b, %Y") %>
              </span>
              <span class="font-bold text-gray-900">
                ฿<%= recipe.price %>
              </span>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <% if @recipes.empty? %>
      <div class="text-center py-20">
        <p class="text-gray-500 text-lg">No recipes found yet.</p>
      </div>
    <% end %>

  </main>
</div>
