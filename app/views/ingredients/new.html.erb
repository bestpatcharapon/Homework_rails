<div class="max-w-2xl mx-auto p-6 bg-white shadow-lg rounded-lg mt-10">
  <h1 class="text-3xl font-bold text-gray-800 mb-6">Add New Ingredient</h1>

  <%= form_with model: @ingredient, class: "space-y-6" do |form| %>
    <% if form.object.errors.any? %>
      <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded">
        <p class="font-bold"><%= pluralize(form.object.errors.count, "error") %> prohibited this ingredient from being saved:</p>
        <ul class="list-disc list-inside mt-2">
          <% form.object.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :name, "Ingredient Name", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_field :name, placeholder: "Enter ingredient name", class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent" %>
    </div>

    <div data-controller="image-preview">
      <%= form.label :image, "Image", class: "block text-sm font-medium text-gray-700 mb-2" %>
      
      <div data-image-preview-target="dropZone"
           data-action="dragover->image-preview#dragover dragleave->image-preview#dragleave drop->image-preview#drop"
           class="border-2 border-dashed border-gray-300 rounded-lg p-8 text-center hover:border-red-400 transition">
        
        <div data-image-preview-target="placeholder">
          <svg class="mx-auto h-12 w-12 text-red-400 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <p class="text-gray-600 mb-2">Drag & Drop image here</p>
        </div>
        
        <div data-image-preview-target="area" class="hidden">
          <img data-image-preview-target="preview" src="" alt="Preview" class="max-h-64 rounded-lg shadow mx-auto mb-4">
          
          <div class="bg-gray-100 rounded-lg p-3 mb-4 inline-block">
            <p class="text-sm text-gray-700"><strong>Filename:</strong> <span data-image-preview-target="name"></span></p>
            <p class="text-xs text-gray-500"><strong>Size:</strong> <span data-image-preview-target="size"></span></p>
          </div>
          
          <div class="flex justify-center space-x-4">
            <p class="text-gray-600 mb-2 cursor-pointer hover:text-red-500" data-action="click->image-preview#remove">ลบรูปภาพ</p>
            
          </div>
        </div>
        
        <label for="ingredient_image" class="inline-block bg-red-500 hover:bg-red-600 text-white font-medium py-2 px-6 rounded-lg cursor-pointer transition">
          Choose file
        </label>
        <p class="text-xs text-gray-500 mt-2">Supported formats: PNG, TFF, JPG, up to 24 MB</p>
        <%= form.file_field :image, accept: "image/*", class: "hidden", id: "ingredient_image", 
            data: { action: "change->image-preview#preview", image_preview_target: "input" } %>
      </div>
    </div>

    <div class="flex space-x-4 border-t pt-6">
      <%= link_to "Cancel", recipes_path, class: "px-4 py-2 bg-gray-500 text-white rounded hover:bg-gray-600 transition" %>
      <%= form.submit "Add Ingredient", class: "px-4 py-2 bg-red-500 text-white rounded hover:bg-red-600 transition" %>
    </div>
  <% end %>
</div>
