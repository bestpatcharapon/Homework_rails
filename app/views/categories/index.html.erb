<div class="flex h-screen bg-gray-50">
  <!-- Sidebar -->
  <aside class="w-64 bg-red-500 text-white flex flex-col">
    <div class="p-6 flex items-center justify-center border-b border-red-400">
      <div class="text-center">
        <div class="block mb-2">
          <img src="https://img5.pic.in.th/file/secure-sv1/-edited-removebg-preview.png" alt="โลโก้กาแฟ edited removebg preview" width="100" height="100" class="mx-auto">
        </div>
        <h1 class="font-bold text-lg">Best Kitchen</h1>
         <div class="mb-2 text-sm text-red-100 font-medium truncate"><%= current_user&.email %></div>
      </div>
    </div>
    
    <nav class="flex-1 py-6">
      <ul>
        <li>
          <%= link_to recipes_path, class: "block py-3 px-6 hover:bg-red-600 transition text-red-100" do %>
            <i class="fa-solid fa-burger"></i>
            <span class="mr-2"></span> Recipes
          <% end %>
        </li>
        <li>
          <%= link_to ingredients_path, class: "block py-3 px-6 hover:bg-red-600 transition text-red-100" do %>
          <i class="fa-solid fa-pizza-slice"></i>
            <span class="mr-2"></span> Ingredients
          <% end %>
        </li>
        <li>
          <%= link_to categories_path, class: "block py-3 px-6 bg-red-600 border-l-4 border-white font-semibold" do %>
          <i class="fa-solid fa-list"></i>
            <span class="mr-2"></span> Categories
          <% end %>
        </li>
      </ul>
    </nav>
    
    <div class="p-6 border-t border-red-400">
      <%= button_to destroy_user_session_path, method: :delete, class: "flex items-center text-red-100 hover:text-white transition" do %>
        <i class="fa-solid fa-arrow-right-from-bracket"></i>
        <span class="mr-2"></span> Sign out
      <% end %>
    </div>
  </aside>

  <!-- Main Content -->
  <main class="flex-1 overflow-y-auto">
    <div class="p-8">
      <!-- Header -->
      <div class="flex justify-between items-center mb-8">
        <h2 class="text-3xl font-bold text-gray-800">Categories List</h2>
        <%= link_to new_category_path, class: "bg-red-500 hover:bg-red-600 text-white font-bold py-2 px-6 rounded shadow transition flex items-center" do %>
          <span class="mr-2">+</span> Add Category
        <% end %>
      </div>

      <% if notice %>
        <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded mb-6">
          <%= notice %>
        </div>
      <% end %>

      <!-- Table Container -->
      <div class="bg-white rounded-lg shadow overflow-hidden">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-red-200 text-red-800 text-sm uppercase tracking-wider">
              <th class="p-4 font-semibold border-b border-red-300">#</th>
              <th class="p-4 font-semibold border-b border-red-300">Category Name</th>
              <th class="p-4 font-semibold border-b border-red-300">Remark</th>
              <th class="p-4 font-semibold border-b border-red-300">Used in Recipes</th>
              <th class="p-4 font-semibold border-b border-red-300 text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% if @categories.any? %>
              <% @categories.each_with_index do |category, index| %>
                <tr class="hover:bg-red-50 transition duration-150">
                  <td class="p-4 text-gray-600"><%= index + 1 %></td>
                  <td class="p-4 font-medium text-gray-800"><%= category.name %></td>
                  <td class="p-4 text-gray-600"><%= category.remark %></td>
                  <td class="p-4 text-gray-600"><%= category.recipes.count %> recipes</td>
                  <td class="p-4 text-right">
                    <div class="flex justify-end space-x-2">
                      <%= link_to "Edit", edit_category_path(category), class: "text-blue-600 hover:text-blue-800 underline text-sm font-medium transition" %>
                      <%= link_to "Delete", category_path(category), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this category?" }, class: "text-red-600 hover:text-red-800 underline text-sm font-medium transition" %>
                    </div>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="5" class="p-8 text-center text-gray-500">
                  No categories found. <%= link_to "Add your first category", new_category_path, class: "text-red-600 hover:underline font-medium" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>
