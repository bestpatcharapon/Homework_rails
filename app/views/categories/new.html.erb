<div class="max-w-2xl mx-auto p-6 bg-white shadow-lg rounded-lg mt-10">
  <h1 class="text-3xl font-bold text-gray-800 mb-6">Add New Category</h1>

  <%= form_with model: @category, class: "space-y-6" do |form| %>
    <% if form.object.errors.any? %>
      <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded">
        <p class="font-bold"><%= pluralize(form.object.errors.count, "error") %> prohibited this category from being saved:</p>
        <ul class="list-disc list-inside mt-2">
          <% form.object.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :name, "Category Name", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_field :name, placeholder: "Enter category name", class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent" %>
    </div>

    <div>
      <%= form.label :remark, "Remark", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_area :remark, placeholder: "Enter category description", rows: 4, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent" %>
    </div>

    <div class="flex space-x-4 border-t pt-6">
      <%= link_to "Cancel", categories_path, class: "px-4 py-2 bg-gray-500 text-white rounded hover:bg-gray-600 transition" %>
      <%= form.submit "Add Category", class: "px-4 py-2 bg-red-500 text-white rounded hover:bg-red-600 transition" %>
    </div>
  <% end %>
</div>
