<div class="max-w-4xl mx-auto p-6 bg-white shadow-lg rounded-lg mt-10">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-800"><%= @recipe.name %></h1>
    <span class="bg-blue-100 text-blue-800 text-sm font-medium mr-2 px-2.5 py-0.5 rounded">
      <%= @recipe.category&.name || "Uncategorized" %>
    </span>
  </div>

  <% if @recipe.image.attached? %>
    <div class="mb-6">
      <%= image_tag @recipe.image, class: "w-full h-96 object-cover rounded-lg shadow-md" %>
    </div>
  <% end %>

  <div class="mb-6">
    <h2 class="text-xl font-semibold text-gray-700 mb-2">Description</h2>
    <p class="text-gray-600 leading-relaxed"><%= @recipe.description %></p>
  </div>

  <div class="mb-6">
    <h2 class="text-xl font-semibold text-gray-700 mb-2">Price</h2>
    <p class="text-2xl font-bold text-green-600"><%= number_to_currency(@recipe.price, unit: "฿") %></p>
  </div>

  <div class="mb-8">
    <h2 class="text-xl font-semibold text-gray-700 mb-2">Ingredients</h2>
    <ul class="list-disc list-inside bg-gray-50 p-4 rounded-lg">
      <% @recipe.ingredients.each do |ingredient| %>
        <li class="text-gray-600 mb-1"><%= ingredient.name %></li>
      <% end %>
    </ul>
  </div>

  <div class="flex space-x-4 border-t pt-6">
    <%= link_to "Edit", edit_recipe_path(@recipe), class: "px-4 py-2 bg-yellow-500 text-white rounded hover:bg-yellow-600 transition" %>
    <%= link_to "Delete", recipe_path(@recipe), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "px-4 py-2 bg-red-500 text-white rounded hover:bg-red-600 transition" %>
    <%= link_to "Back to Menu", recipes_path, class: "px-4 py-2 bg-gray-500 text-white rounded hover:bg-gray-600 transition" %>
  </div>
</div>
