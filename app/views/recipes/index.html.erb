
<div class=" flex h-screen bg-gray-50">
  <!-- Sidebar -->
  <aside class="w-64 bg-red-500 text-white flex flex-col">
    <div class="p-6 flex items-center justify-center border-b border-red-400">
      <!-- Placeholder Logo -->
      <div class="text-center">
        <div class="block mb-2">
          <img src="https://img5.pic.in.th/file/secure-sv1/-edited-removebg-preview.png" alt="โลโก้กาแฟ edited removebg preview" width="100" height="100" class="mx-auto">
        </div>
        <h1 class="font-bold text-lg">Best Kitchen</h1>
        <div class="mb-2 text-sm text-red-100 font-medium truncate"><%= current_user&.email %></div>
      </div>
    </div>

    <nav class="flex-1 py-6">
      <ul>
        <li>
          <%= link_to recipes_path, class: "block py-3 px-6 bg-red-600 border-l-4 border-white font-semibold" do %>
            <i class="fa-solid fa-burger"></i>
            <span class="mr-2"></span> Recipes
          <% end %>
        </li>
        <li>
          <%= link_to ingredients_path, class: "block py-3 px-6 hover:bg-red-600 transition text-red-100" do %>
          <i class="fa-solid fa-pizza-slice"></i>
            <span class="mr-2"></span> Ingredients
          <% end %>
        </li>
        <li>
          <%= link_to categories_path, class: "block py-3 px-6 hover:bg-red-600 transition text-red-100" do %>
          <i class="fa-solid fa-list"></i>
            <span class="mr-2"></span> Categories
          <% end %>
        </li>
      </ul>
    </nav>
    
    <div class="p-6 border-t border-red-400">
      <%= button_to destroy_user_session_path, method: :delete, class: "flex items-center text-red-100 hover:text-white transition w-full text-left" do %>
         <i class="fa-solid fa-arrow-right-from-bracket"></i>
        <span class="mr-2"></span> Sign out
      <% end %>
    </div>
  </aside>

  <!-- Main Content -->
  <main class="flex-1 overflow-y-auto">
    <div class="p-8">
      <!-- Header -->
      <div class="flex justify-between items-center mb-8">
        <h2 class="text-3xl font-bold text-gray-800">Recipes List</h2>
        
        <!-- Buttons Group -->
        <div class="flex space-x-4">
          <%= link_to new_recipe_path, class: "bg-red-500 hover:bg-red-600 text-white font-bold py-2 px-6 rounded shadow transition flex items-center" do %>
            <span class="mr-2">+</span> Add Recipes
          <% end %>
          <%= link_to new_ingredient_path, class: "bg-red-500 hover:bg-red-600 text-white font-bold py-2 px-6 rounded shadow transition flex items-center" do %>
            <span class="mr-2">+</span> Add Ingredient
          <% end %>
        </div>
      </div>


      <!-- Table Container -->
      <div class="bg-white rounded-lg shadow overflow-hidden">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-red-200 text-red-800 text-sm uppercase tracking-wider">
              <th class="p-4 font-semibold border-b border-red-300">#</th>
              <th class="p-4 font-semibold border-b border-red-300">Recipes Name</th>
              <th class="p-4 font-semibold border-b border-red-300">Category</th>
              <th class="p-4 font-semibold border-b border-red-300">Date Create</th>
              <th class="p-4 font-semibold border-b border-red-300 text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @recipes.each_with_index do |recipe, index| %>
              <tr class="hover:bg-red-50 transition duration-150">
                <td class="p-4 text-gray-600"><%= index + 1 %></td>
                <td class="p-4 font-medium text-gray-800"><%= recipe.name %></td>
                <td class="p-4 text-gray-600"><%= recipe.category&.name || "Uncategorized" %></td>
                <td class="p-4 text-gray-600"><%= recipe.created_at.strftime("%d/%m/%Y") %></td>
                <td class="p-4 text-right">
                  <%= link_to "View Detail", recipe_path(recipe), class: "text-gray-500 hover:text-red-500 underline text-sm font-medium transition" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
</div>
