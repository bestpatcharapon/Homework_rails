<div class="flex h-screen bg-gray-50">
  <!-- Sidebar -->
  <aside class="w-64 bg-red-500 text-white flex flex-col">
    <div class="p-6 flex items-center justify-center border-b border-red-400">
      <!-- Placeholder Logo -->
      <div class="text-center">
        <div class="block mb-2">
          <img src="https://img5.pic.in.th/file/secure-sv1/-edited-removebg-preview.png" alt="โลโก้กาแฟ edited removebg preview" width="100" height="100" class="mx-auto">
        </div>
        <h1 class="font-bold text-lg">Best Kitchen</h1>
      </div>
    </div>
    
    <nav class="flex-1 py-6">
      <ul>
        <li>
          <%= link_to recipes_path, class: "block py-3 px-6 bg-red-600 border-l-4 border-white font-semibold" do %>
            <span class="mr-2"></span> Recipes
          <% end %>
        </li>
      </ul>
    </nav>
    
    <div class="p-6 border-t border-red-400">
      <a href="#" class="flex items-center text-red-100 hover:text-white transition">
        <span class="mr-2"></span> Sign out
      </a>
    </div>
  </aside>

  <main class="flex-1 flex flex-col h-screen">
    <!-- Fixed Header -->
    <div class="bg-white border-b border-gray-200 px-8 py-4 flex-shrink-0">
      <%= link_to recipes_path, class: "text-gray-600 hover:text-gray-800 flex items-center" do %>
        <span class="mr-2">←</span> Edit Recipe
      <% end %>
    </div>

    <!-- Scrollable Form Content -->
    <div class="flex-1 overflow-y-auto px-8 py-6">
      <div class="bg-white rounded-lg shadow p-8">
        <!-- Form fields without buttons -->
        <%= form_with model: @recipe, class: "space-y-6" do |form| %>
          <% if form.object.errors.any? %>
            <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded">
              <p class="font-bold"><%= pluralize(form.object.errors.count, "error") %> prohibited this recipe from being saved:</p>
              <ul class="list-disc list-inside mt-2">
                <% form.object.errors.each do |error| %>
                  <li><%= error.full_message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Left Column: Image Upload -->
            <div data-controller="image-preview">
              <%= form.label :image, "Image", class: "block text-sm font-medium text-gray-700 mb-2" %>
              
              <!-- Upload box with integrated image preview -->
              <div data-image-preview-target="dropZone"
                   data-action="dragover->image-preview#dragover dragleave->image-preview#dragleave drop->image-preview#drop"
                   class="border-2 border-dashed border-gray-300 rounded-lg p-8 text-center hover:border-red-400 transition h-full flex flex-col justify-center items-center min-h-[400px]">
                
                <!-- Placeholder (shown if no image or removed) -->
                <div data-image-preview-target="placeholder" class="<%= @recipe.image.attached? ? 'hidden' : '' %>">
                  <svg class="mx-auto h-12 w-12 text-red-400 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <p class="text-gray-600 mb-2">Drag & Drop image here</p>
                </div>

                <!-- Preview area (shown if image exists or uploaded) -->
                <div data-image-preview-target="area" class="<%= @recipe.image.attached? ? '' : 'hidden' %> w-full">
                  <% if @recipe.image.attached? %>
                    <%= image_tag @recipe.image, class: "max-h-80 mx-auto rounded-lg shadow mb-4 object-contain", data: { image_preview_target: "preview" } %>
                  <% else %>
                    <img data-image-preview-target="preview" src="" alt="Preview" class="max-h-80 rounded-lg shadow mx-auto mb-4 object-contain">
                  <% end %>
                  
                  <!-- File info -->
                  <div class="bg-gray-100 rounded-lg p-3 mb-4 inline-block">
                    <p class="text-sm text-gray-700"><strong>Filename:</strong> <span data-image-preview-target="name"><%= @recipe.image.filename if @recipe.image.attached? %></span></p>
                    <p class="text-xs text-gray-500"><strong>Size:</strong> <span data-image-preview-target="size"><%= (@recipe.image.byte_size / 1024.0).round(2) if @recipe.image.attached? %> KB</span></p>
                  </div>
                  
                  <div class="flex justify-center space-x-4">
                    <p class="text-gray-600 mb-2 cursor-pointer hover:text-red-500" data-action="click->image-preview#remove">Remove Image</p>
                  </div>
                </div>
                
                <label for="recipe_image" class="inline-block bg-red-500 hover:bg-red-600 text-white font-medium py-2 px-6 rounded-lg cursor-pointer transition mt-4">
                  Choose file
                </label>
                <p class="text-xs text-gray-500 mt-2">Supported formats: PNG, TFF, JPG, up to 24 MB</p>
                <%= form.file_field :image, accept: "image/*", class: "hidden", id: "recipe_image", 
                    data: { action: "change->image-preview#preview", image_preview_target: "input" } %>
                <%= form.hidden_field :remove_image, value: 0, data: { image_preview_target: "removeInput" } %>
              </div>
            </div>

            <!-- Right Column: Form Fields -->
            <div class="space-y-6">
              <div>
                <%= form.label :name, "Recipe Name", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= form.text_field :name, placeholder: "Recipe Name", class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent" %>
              </div>

              <div>
                <%= form.label :category_id, "Category", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= form.collection_select :category_id, Category.all, :id, :name, 
                    { prompt: "Select category" }, 
                    { class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent" } %>
              </div>

              <div>
                <%= form.label :description, "Description", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= form.text_area :description, placeholder: "Please enter description", rows: 4, 
                    class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent" %>
              </div>

              <div>
                <%= form.label :price, "Price", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= form.number_field :price, step: 0.01, placeholder: "0.00", 
                    class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent" %>
              </div>

              <div>
                <%= form.label :ingredient_ids, "Ingredients", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <div class="border border-gray-300 rounded-lg p-4 max-h-48 overflow-y-auto">
                  <div class="grid grid-cols-2 gap-4">
                    <%= form.collection_check_boxes :ingredient_ids, Ingredient.all, :id, :name do |b| %>
                      <div class="flex items-center">
                        <%= b.check_box class: "w-4 h-4 text-red-500 border-gray-300 rounded focus:ring-red-500" %>
                        <%= b.label class: "ml-2 text-sm text-gray-700" %>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Hidden submit for form submission -->
          <%= form.submit id: "hidden-submit", class: "hidden" %>
        <% end %>
      </div>
    </div>

    <!-- Fixed Footer with Buttons -->
    <div class="bg-white border-t border-gray-200 px-8 py-4 flex justify-end space-x-4 flex-shrink-0">
      <%= link_to "Cancel", recipes_path, class: "px-6 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition" %>
      <button onclick="document.getElementById('hidden-submit').click()" class="px-6 py-2 bg-gray-400 hover:bg-gray-500 text-white rounded-lg transition cursor-pointer">
        Update Recipe
      </button>
    </div>
  </main>
</div>
